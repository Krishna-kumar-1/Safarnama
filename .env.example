# ==============================================================================
# Indian Railways Route Finder & NTES Live Cloud Portal ("Safarnama")
# Environment Variables & API Key Configuration Template
# ==============================================================================
# Copy this file to .env and insert your API keys:
#
#   Windows (CMD / PowerShell):
#     copy .env.example .env
#
#   Linux / macOS:
#     cp .env.example .env
#
# NOTE: The core route engine, timetable search, and graph routing work 100%
# offline using the built-in database of 12,466+ trains even without API keys!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini Generative AI (Hinglish & Voice Route Planner)
# ------------------------------------------------------------------------------
# Powers natural language train discovery, voice speech-to-text queries,
# and smart timetable synthesis.
#
# Obtain your FREE API key in 30 seconds:
# 👉 https://aistudio.google.com/
#
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. RailKit Multi-Account API Pool (Primary Live Data Provider - Tier 1)
# ------------------------------------------------------------------------------
# Provides live PNR verification, real-time satellite GPS tracking,
# IRCTC seat availability, and live station departure boards.
#
# Obtain FREE API keys (50 requests/day per free account):
# 👉 https://www.railkit.in/dashboard
#
# You can provide multiple comma-separated keys for automatic pooling & failover!
# (e.g. 5 keys = 250 free live queries / day)
#
RAILKIT_API_KEYS=""

# Or specify a single key:
# RAILKIT_API_KEY=""

# ------------------------------------------------------------------------------
# 3. RapidAPI Official IRCTC Endpoints (Secondary Failover Provider - Tier 2)
# ------------------------------------------------------------------------------
# Automatic failover provider if RailKit rate limits are reached.
#
# Obtain FREE API keys:
# 👉 https://rapidapi.com/IRCTCAPI/api/irctc1
#
RAPIDAPI_KEYS=""
RAPIDAPI_HOST="irctc1.p.rapidapi.com"

# ------------------------------------------------------------------------------
# 4. Google Maps Platform API (Optional Satellite & Hybrid Map Imagery)
# ------------------------------------------------------------------------------
# Enables high-resolution Google Satellite, Hybrid, Roadmap, and Terrain
# map layers in the interactive route visualizer alongside OpenRailwayMap.
#
# Obtain your API key from Google Cloud Console:
# 👉 https://console.cloud.google.com/google/maps-apis/
#
GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 5. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
HOST="0.0.0.0"
